# QUANTEDGE ships in demo mode by default — no backend required.
#
# To connect the real QUANTEDGE backend once it's available, copy this file
# to `.env.local` and set:
#
#   VITE_DEMO_MODE=false
#   VITE_API_BASE_URL=https://your-backend.example.com/api
#
# Every function in src/api/*.ts checks IS_DEMO_MODE and calls the mock data
# layer (src/mocks/*.ts) when true, or apiFetch() against VITE_API_BASE_URL
# when false. No component or page code needs to change either way.

VITE_DEMO_MODE=true
VITE_API_BASE_URL=
