# Copy this file to .env for local development. Never commit real secrets —
# .env is gitignored.

ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# --- Database ---
DATABASE_URL=postgresql+asyncpg://quantedge:quantedge@localhost:5432/quantedge
DATABASE_URL_SYNC=postgresql+psycopg2://quantedge:quantedge@localhost:5432/quantedge

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Comma-separated list of allowed frontend origins. Never use "*" in production.
CORS_ORIGINS=http://localhost:5173

# --- Market data provider ---
# "mock" (default, deterministic synthetic data) or "mt5"
MARKET_DATA_PROVIDER=mock
MT5_ENABLED=false
MT5_SERVER=
MT5_LOGIN=
MT5_PASSWORD=

# --- Sentiment provider ---
# "mock" (default) or "news"
SENTIMENT_PROVIDER=mock
NEWS_PROVIDER=
NEWS_API_KEY=

# --- Development seed mode ---
# Populates a few deterministic backtest runs on startup so
# /trades/history and /performance/* aren't empty on first integration.
# Automatically skipped once ENVIRONMENT=production.
SEED_ON_STARTUP=true
